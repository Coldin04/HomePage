---
layout: shared/base.njk
---
<div class="main-div friends-layout">
    <header class="page-header">
        <a href="/" class="page-back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> 返回首页</a>
        <h1 class="page-title">{{ heading | default(title) }}</h1>
    </header>

    <main class="info-text page-content">
        <section class="friends-apply" aria-label="申请友链">
            {{ content | safe }}
        </section>

        <section class="friends-grid" aria-label="友情链接">
            {% for friend in friends %}
                <article class="friend-card{% if not friend.website %} friend-card-unavailable{% endif %}">
                {% if friend.website %}
                    <a class="friend-card-link" href="{{ friend.website | escape }}" target="_blank" rel="noopener noreferrer">
                {% else %}
                    <div class="friend-card-link">
                {% endif %}
                        <span class="friend-avatar">
                            {% if friend.image %}
                                <img src="{{ friend.image | escape }}" alt="" width="64" height="64" loading="lazy" decoding="async" referrerpolicy="no-referrer">
                                <span class="friend-avatar-fallback" aria-hidden="true"><i class="fa-solid fa-image"></i></span>
                            {% else %}
                                <span class="friend-avatar-fallback friend-avatar-unavailable" aria-hidden="true"><i class="fa-solid fa-link-slash"></i></span>
                            {% endif %}
                        </span>
                        <div class="friend-details">
                            <h2 class="friend-name">{{ friend.title | escape }}</h2>
                            <p class="friend-description">{{ friend.description | escape }}</p>
                        </div>
                {% if friend.website %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
                    <button class="friend-description-tooltip-toggle" type="button" aria-controls="friend-description-popover-{{ loop.index }}" aria-describedby="friend-description-popover-{{ loop.index }}" aria-expanded="false" aria-label="查看 {{ friend.title | escape }} 的完整简介" hidden>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <span class="friend-description-popover" id="friend-description-popover-{{ loop.index }}" role="tooltip" popover="auto">{{ friend.description | escape }}</span>
                </article>
            {% endfor %}
        </section>
    </main>

    {% include "shared/footer.njk" %}
</div>
<script src="/src/friends.js" defer></script>
